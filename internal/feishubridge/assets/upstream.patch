+  async function dispatchEvent(raw: unknown): Promise<void> {
+    const dispatcher = (channel as unknown as {
+      dispatcher: { invoke: (raw: unknown, options: { needCheck: boolean }) => Promise<unknown> };
+    }).dispatcher;
+    const envelope = raw as { header?: { event_type?: string }; event?: {
+      message_id?: string; context?: { open_message_id?: string };
+    } };
+    if (envelope.header?.event_type !== 'im.message.receive_v1') {
+      // Buttons and reactions point to a card, not its topic root. Resolve the
+      // real topic through Feishu and use the existing local session store.
+      const messageId = envelope.event?.message_id ?? envelope.event?.context?.open_message_id;
+      if (!messageId) return;
+      const response = await channel.rawClient.im.v1.message.get({ path: { message_id: messageId } });
+      const threadId = response.data?.items?.[0]?.thread_id;
+      if (!threadId || !(await getSession(threadId))) return;
+    }
+    await dispatcher.invoke(raw, { needCheck: false });
+  }
+  return { channel, dispatchEvent, submitTask: orchestrator.submitTask, stopTask: orchestrator.stopTask, adminExecute: orchestrator.adminExecute, shutdown };
 }
