+  async function submitTask(task: ExternalTask): Promise<void> {
+    if (shuttingDown) throw new Error('bridge is stopping');
+    const queued: QueuedTurn = { input: { text: task.prompt },
+      titleSource: { text: task.title, rawContentType: 'text' },
+      summary: task.title, requesterOpenId: task.requesterOpenId, requestedAt: Date.now() };
+    const key = task.threadId ?? `pending:${task.rootMessageId}`;
+    const prior = active.get(key);
+    if (prior) { prior.queue.push(queued); return; }
+    const reserved: ActiveState = { queue: [], requesterOpenId: task.requesterOpenId };
+    active.set(key, reserved);
+    try {
+      const be = backendFor(task.backendId);
+      const rec = task.threadId ? await getSession(task.threadId) : undefined;
+      const { model, effort } = pickDefault(await listModels(be), { model: rec?.model ?? task.model, effort: rec?.effort });
+      const resolved = task.threadId ? await resolveThread(task.threadId, task.chatId, { mode: 'full', network: true }) : { thread: undefined };
+      const thread = resolved.thread ?? await be.startThread({ cwd: task.cwd, model, effort, mode: 'full', network: true });
+      if (reserved.intakeCancelled || shuttingDown) {
+        await thread.close();
+        await externalHooks?.onTurn?.({ phase: 'failed', rootMessageId: task.rootMessageId, chatId: task.chatId,
+          threadId: task.threadId, sessionId: thread.sessionId, cwd: task.cwd,
+          terminal: 'interrupted', text: 'Task cancelled before starting' });
+        return;
+      }
+      if (task.threadId) await upsertSession({ threadId: task.threadId, chatId: task.chatId, cwd: task.cwd,
+        sessionId: thread.sessionId, backend: be.id, model, effort,
+        summary: task.title, createdAt: rec?.createdAt ?? Date.now(), updatedAt: Date.now() });
+      await trackRun(launchRun({ chatId: task.chatId, replyTo: task.rootMessageId,
+        knownThreadId: task.threadId, replyInThread: true, thread,
+        firstText: task.prompt, cwd: task.cwd, mode: 'full', model, effort,
+        backendId: be.id, summary: task.title, requesterOpenId: task.requesterOpenId,
+        titleSource: queued.titleSource }));
+    } catch (err) {
+      await externalHooks?.onTurn?.({ phase: 'failed', rootMessageId: task.rootMessageId, chatId: task.chatId,
+        threadId: task.threadId, cwd: task.cwd, terminal: 'error',
+        text: err instanceof Error ? err.message : String(err) });
+      throw err;
+    } finally {
+      if (active.get(key) === reserved) active.delete(key);
+    }
+  }
+  function stopTask(threadId: string): boolean {
+    const state = active.get(threadId);
+    if (!state) return false;
+    state.queue.splice(0);
+    state.intakeCancelled = true;
+    state.interrupt?.();
+    return true;
+  }
+  return { submitTask, stopTask, onMessage, onComment, onBotAddedToChat, onBotRemovedFromChat, onReaction, onBotMenu, dispatcher, adminExecute, shutdown };
 }
 
